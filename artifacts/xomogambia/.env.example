# Copy this file to .env and fill in the values for local development.
# Expo reads EXPO_PUBLIC_* variables and makes them available to the app bundle.

# API server base URL (no trailing slash).
# - On Replit web this is auto-detected from the window hostname.
# - Set this when running natively (iOS/Android) or on your own machine.
EXPO_PUBLIC_API_URL=http://localhost:8080

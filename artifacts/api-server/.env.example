# Copy this file to .env and fill in the values for local development.
# On Replit these are set automatically by the platform.

# Required: port the API server listens on
PORT=8080

# Required: PostgreSQL connection string.
# On Replit this is set automatically.
# Locally: create a database and paste its connection string here.
DATABASE_URL=postgresql://user:password@localhost:5432/xomogambia

# Optional: log level (trace | debug | info | warn | error)
LOG_LEVEL=info

NODE_ENV=development

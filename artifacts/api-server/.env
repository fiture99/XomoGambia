# Copy this file to .env and fill in the values for local development.
# On Replit these are set automatically by the platform.

# Required: port the API server listens on
PORT=8080

# Optional: PostgreSQL connection string.
# When set, the server will use Postgres instead of the local JSON file store.
DATABASE_URL=postgresql://postgres:sa@localhost:5432/xomogambia

# Optional: log level (trace | debug | info | warn | error)
LOG_LEVEL=info

NODE_ENV=development

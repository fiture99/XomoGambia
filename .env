# Root workspace env example.
# Copy to .env — Node 24 loads it automatically via --env-file-if-exists.
#
# Each artifact also has its own .env.example:
#   artifacts/api-server/.env.example
#   artifacts/xomogambia/.env.example

# ── API Server ─────────────────────────────────────────────────────────────
PORT=8080

# PostgreSQL connection (leave blank to use the local JSON file store)
DATABASE_URL=postgresql://postgres:sa@localhost:5432/xomogambia

NODE_ENV=development

# ── Mobile App (Expo) ──────────────────────────────────────────────────────
# Override the API base URL for native (iOS/Android) or local web dev.
# Not needed when running inside Replit — the URL is auto-detected.
EXPO_PUBLIC_API_URL=http://192.168.1.164:8080
